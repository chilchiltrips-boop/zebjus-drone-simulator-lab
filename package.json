{
  "name": "zebjus-aerion-controller",
  "version": "18.4.0",
  "private": true,
  "description": "Simple local ZEBJUS controller, USB/OTA firmware updater and matching Android app",
  "scripts": {
    "start": "node server.js",
    "check": "python3 tools/validate_project.py && python3 tools/validate_offline_bundle.py",
    "test:browser": "node tools/test_controller_browser.js",
    "test:control": "node tools/test_firmware_updater.js && node tools/test_android_transport.js",
    "test:flight-math": "g++ -std=c++17 tools/test_flight_math.cpp -o /tmp/aerion-flight-math && /tmp/aerion-flight-math",
    "test:rc-link": "g++ -std=c++17 tools/test_rc_link.cpp -o /tmp/aerion-rc-link && /tmp/aerion-rc-link",
    "test:fc-setup": "g++ -std=c++17 tools/test_fc_setup.cpp -o /tmp/aerion-fc-setup && /tmp/aerion-fc-setup && python3 tools/test_fc_setup_runtime.py",
    "release:seal": "python3 tools/embed_ap_pages.py && python3 tools/make_offline_manifest.py && python3 tools/release_integrity.py --write",
    "release:check": "python3 tools/release_integrity.py --check"
  }
}
