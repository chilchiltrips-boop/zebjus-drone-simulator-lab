{
  "name": "zebjus-flightcore-drone-lab",
  "version": "18.3.65",
  "private": true,
  "description": "ZEBJUS Aerion \u2014 Build, Code, Fly with offline Python and drone simulation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "python3 tools/validate_project.py && python3 tools/validate_offline_bundle.py",
    "test:flight": "node tools/test_flight_app_browser.js",
    "test:offline": "node tools/test_offline_browser.js",
    "test:control": "node tools/test_joystick_runtime.js && node tools/test_reconnect_runtime.js && node tools/test_firmware_updater.js && node tools/test_camera_lifecycle.js && node tools/test_python_output_lifecycle.js",
    "test:real-browser": "node tools/test_real_control_browser.js",
    "test:mobile-view": "node tools/test_mobile_view_browser.js",
    "test:flight-math": "g++ -std=c++17 tools/test_flight_math.cpp -o /tmp/aerion-flight-math && /tmp/aerion-flight-math",
    "test:rc-link": "g++ -std=c++17 tools/test_rc_link.cpp -o /tmp/aerion-rc-link && /tmp/aerion-rc-link",
    "test:recovery": "node tools/test_control_recovery_browser.js",
    "test:setup": "python3 -B tools/test_firmware_setup.py",
    "test:ui": "node tools/test_aerion_controls_browser.js",
    "test:upload": "python3 -B tools/test_upload_integrity.py",
    "release:seal": "python3 -B tools/cleanup_repo.py && python3 -B tools/make_offline_manifest.py && python3 -B tools/release_integrity.py --write",
    "release:check": "python3 -B tools/release_integrity.py --check",
    "test:network": "node tools/test_network_control_browser.js",
    "test:fc-setup": "g++ -std=c++17 tools/test_fc_setup.cpp -o /tmp/aerion-fc-setup && /tmp/aerion-fc-setup && python3 tools/test_fc_setup_runtime.py",
    "test:setup-browser": "node tools/test_fc_setup_browser.js",
    "test:floating": "node tools/test_floating_sticks_browser.js",
    "test:training-core": "node tools/test_flight_training_core.js",
    "test:learning-browser": "node tools/test_learning_lab_browser.js"
  }
}
